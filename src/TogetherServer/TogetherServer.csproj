<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TogetherServer</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\ui\dist\**\*" LogicalName="Ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="EnsureUiAssets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\..\ui\dist\index.html')" Text="Build ui/ with npm ci and npm run build before building TogetherServer." />
  </Target>
</Project>
